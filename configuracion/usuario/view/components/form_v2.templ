package components

import (
	"PlantillaInstitucional/configuracion/usuario"
	"PlantillaInstitucional/shared/views/components"
	"PlantillaInstitucional/shared/views/components/v2"
)

templ FormCreateUsuarioV2(u usuario.Usuario, personas []components.SelectOption, errors map[string]string) {
	@v2.ModalV2("Nuevo Usuario") {
		<form hx-post="/configuracion/usuarios/" hx-target="#modal" hx-swap="innerHTML" class="space-y-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
				@v2.InputFieldV2(v2.InputPropsV2{
					Label: "Email del Usuario",
					Name: "email",
					Type: "email",
					Placeholder: "Ej. algo@issemym.gob.mx",
					Value: u.Email,
					Required: true,
					Errors: errors,
				})
				@v2.InputFieldV2(v2.InputPropsV2{
					Label: "Perfil / Rol",
					Name: "perfil",
					Placeholder: "Ej. ADMINISTRADOR",
					Value: u.Perfil,
					Required: true,
					Errors: errors,
				})
				
				<div class="md:col-span-2">
					@v2.SelectFieldV2(v2.SelectProps{
						Label: "Persona Vinculada",
						Name: "uuid_persona",
						Options: personas,
						SelectedValue: u.UuidPersona.String(),
						Required: true,
						Errors: errors,
					})
				</div>
			</div>
			@v2.ModalFooterV2("Guardar Usuario")
		</form>
	}
}

templ FormUpdateUsuarioV2(u *usuario.Usuario, personas []components.SelectOption, errors map[string]string) {
	@v2.ModalV2("Editar Usuario") {
		<form hx-put={ "/configuracion/usuarios/" + u.UuidPersona.String() + "/" } hx-target="#modal" hx-swap="innerHTML" class="space-y-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
				@v2.InputFieldV2(v2.InputPropsV2{
					Label: "Nombre Completo",
					Name: "nombre",
					Value: u.NombreCompleto,
					Errors: errors,
				})
				@v2.InputFieldV2(v2.InputPropsV2{
					Label: "Correo Electrónico",
					Name: "email",
					Type: "email",
					Value: u.Email,
					Errors: errors,
				})
				@v2.InputFieldV2(v2.InputPropsV2{
					Label: "Perfil asignado",
					Name: "perfil",
					Value: u.Perfil,
					Errors: errors,
				})
				
				@v2.InputFieldV2(v2.InputPropsV2{
					Label: "ID Único",
					Name: "uuid_persona_display",
					Value: u.UuidPersona.String(),
					Disabled: true,
				})
			</div>
			@v2.ModalFooterV2("Guardar Cambios")
		</form>
	}
}
