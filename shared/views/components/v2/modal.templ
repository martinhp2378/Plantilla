package v2

templ ModalV2(title string) {
	<div
		id="modal-container"
		class="fixed inset-0 z-[100] flex items-center justify-center p-4 md:p-6 bg-black/60 backdrop-blur-sm overflow-y-auto"
		x-data="{ active: true }"
		x-show="active"
		@keydown.escape.window="active = false; setTimeout(() => { document.getElementById('modal').innerHTML = '' }, 150)"
	>
		<div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl my-auto flex flex-col max-h-[92vh] overflow-hidden border border-[var(--color-arena)]">
			<!-- Header Naranja Vibrante Fijo -->
			<div class="bg-[var(--color-naranja)] px-8 py-5 flex items-center justify-between shadow-lg shrink-0">
				<div class="flex items-center gap-3 text-white">
					<span class="material-icons text-2xl">edit_note</span>
					<h3 class="text-xl font-black uppercase tracking-tight">{ title }</h3>
				</div>
				<button
					@click="active = false; setTimeout(() => { document.getElementById('modal').innerHTML = '' }, 150)"
					class="w-10 h-10 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/30 text-white transition-colors"
				>
					<span class="material-icons">close</span>
				</button>
			</div>

			<!-- Body del Modal (Scroll Interno Responsivo) -->
			<div class="p-6 md:p-10 overflow-y-auto flex-1">
				{ children... }
			</div>
		</div>
	</div>
}

templ ModalFooterV2(btnText string) {
	<div class="pt-8 flex justify-end gap-4 border-t border-[var(--color-arena)]">
		<button
			type="button"
			@click="active = false; setTimeout(() => { document.getElementById('modal').innerHTML = '' }, 150)"
			class="px-8 py-3 text-sm font-bold text-gray-500 hover:text-[var(--color-guinda)] uppercase tracking-widest transition-colors"
		>
			Cancelar
		</button>
		<button
			type="submit"
			class="bg-[var(--color-naranja)] px-10 py-3 text-sm font-black text-white uppercase tracking-widest hover:brightness-110 transition-all shadow-lg rounded-lg"
		>
			{ btnText }
		</button>
	</div>
}
