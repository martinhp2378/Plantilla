package components

import "PlantillaInstitucional/shared/sesionutil"

templ MensajesFlash() {
	<div id="flash-messages" class="hidden">
		for _, msg := range sesionutil.PopFlashes(ctx) {
			@renderFlashMessage(msg)
		}
	</div>
}

templ MensajeFlashDirecto(variante, descripcion string) {
	<div hx-swap-oob="beforeend:#toast-container">
		<div
			x-data="{ show: true }"
			x-show="show"
			x-init="setTimeout(() => show = false, 4000); setTimeout(() => $el.remove(), 4500)"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 transform -translate-y-4"
			x-transition:enter-end="opacity-100 transform translate-y-0"
			x-transition:leave="transition ease-in duration-300"
			x-transition:leave-start="opacity-100 transform translate-y-0"
			x-transition:leave-end="opacity-0 transform -translate-y-4"
			class={ "flex items-center w-full max-w-xs p-4 text-gray-500 bg-white rounded-xl shadow-sm dark:text-slate-400 dark:bg-slate-800 " + claseToast(variante) }
			role="alert"
		>
			<div class={ "inline-flex items-center justify-center shrink-0 w-8 h-8 rounded-xl " + claseIconoToast(variante) }>
				<span class="material-icons text-lg">{ iconoToast(variante) }</span>
			</div>
			<div class="ml-3 text-sm font-normal">{ descripcion }</div>
			<button
				type="button"
				@click="show = false; setTimeout(() => $el.closest('[role=alert]').remove(), 350)"
				class="ml-auto -mx-1.5 -my-1.5 bg-white text-gray-400 hover:text-gray-900 rounded-xl focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8 dark:text-slate-1000 dark:hover:text-white dark:bg-slate-800 dark:hover:bg-gray-700"
				aria-label="Cerrar"
			>
				<span class="material-icons text-sm">close</span>
			</button>
		</div>
	</div>
}

templ PiePagina() {
	<footer class="bg-white border-t border-[var(--color-arena)] py-8 mt-auto px-4 sm:px-8 lg:px-12">
		<div class="flex flex-col md:flex-row justify-between items-center gap-6">
			<div class="flex items-center gap-4">
				<div class="w-10 h-10 bg-[var(--surface-arena-20)] rounded-lg flex items-center justify-center">
					<span class="material-icons text-[var(--color-guinda)] text-xl">security</span>
				</div>
				<p class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-tight">
					Sistema Protegido por Estándares
					<br/>
					de Seguridad Institucional
				</p>
			</div>
			<div class="text-center md:text-right">
				<p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.25em]">
					© 2026. Plantilla <span class="text-[var(--color-naranja)]">ISSEMYM</span>
				</p>
				<p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mt-1">
					Tu opinión nos ayuda a mejorar el servicio
				</p>
			</div>
		</div>
	</footer>
}
