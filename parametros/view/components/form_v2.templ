package components

import (
	"PlantillaInstitucional/parametros"
	"PlantillaInstitucional/shared/convertidores"
	"PlantillaInstitucional/shared/views/components"
	"PlantillaInstitucional/shared/views/components/v2"
	"fmt"
)

templ FormCreateParametroV2(p parametros.Parametro, errors map[string]string) {
	@v2.ModalV2("Nuevo Parámetro") {
		<form hx-post="/configuracion/parametros/" hx-target="#modal" hx-swap="innerHTML" class="space-y-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
				{{
					optsTipo := []components.SelectOption{
						{Value: "STRING", Text: "STRING"},
						{Value: "INT", Text: "INT"},
						{Value: "BOOLEAN", Text: "BOOLEAN"},
						{Value: "JSON", Text: "JSON"},
					}
				}}
				@v2.InputFieldV2(v2.InputPropsV2{
					Label:       "Clave",
					Name:        "clave",
					Placeholder: "Ej. SESION_TIMEOUT",
					Value:       p.Clave,
					Required:    true,
					Errors:      errors,
				})
				@v2.InputFieldV2(v2.InputPropsV2{
					Label:       "Valor",
					Name:        "valor",
					Placeholder: "Ej. 3600",
					Value:       p.Valor,
					Required:    true,
					Errors:      errors,
				})
				@v2.SelectFieldV2(v2.SelectProps{
					Label:         "Tipo de Dato",
					Name:          "tipo_dato",
					Options:       optsTipo,
					SelectedValue: p.TipoDato,
					Required:      true,
					Errors:        errors,
				})
				@v2.SelectFieldV2(v2.SelectProps{
					Label:         "Estatus",
					Name:          "activo",
					Options:       convertidores.OptionFromEstatusGenerico(),
					SelectedValue: convertidores.Traducir(p.IsActive),
					Required:      true,
					Errors:        errors,
				})
				<div class="md:col-span-2">
					@v2.TextAreaFieldV2(v2.TextAreaPropsV2{
						Label:       "Descripción",
						Name:        "descripcion",
						Placeholder: "Explique el uso de este parámetro",
						Value:       p.Descripcion,
						Errors:      errors,
					})
				</div>
				<div class="md:col-span-2">
					@v2.InputFieldV2(v2.InputPropsV2{
						Label:       "Motivo de Creación",
						Name:        "razon_i",
						Placeholder: "Ej. Configuración inicial",
						Value:       p.RazonI,
						Required:    true,
						Errors:      errors,
					})
				</div>
			</div>
			@v2.ModalFooterV2("Guardar Parámetro")
		</form>
	}
}

templ FormUpdateParametroV2(p *parametros.Parametro, errors map[string]string) {
	@v2.ModalV2("Editar Parámetro") {
		<form hx-put={ fmt.Sprintf("/configuracion/parametros/%s", p.ParametroId) } hx-target="#modal" hx-swap="innerHTML" class="space-y-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
				{{
					optsTipo := []components.SelectOption{
						{Value: "STRING", Text: "STRING"},
						{Value: "INT", Text: "INT"},
						{Value: "BOOLEAN", Text: "BOOLEAN"},
						{Value: "JSON", Text: "JSON"},
					}
				}}
				@v2.InputFieldV2(v2.InputPropsV2{
					Label:    "Clave",
					Name:     "clave",
					Value:    p.Clave,
					Required: true,
					Errors:   errors,
				})
				@v2.InputFieldV2(v2.InputPropsV2{
					Label:    "Valor",
					Name:     "valor",
					Value:    p.Valor,
					Required: true,
					Errors:   errors,
				})
				@v2.SelectFieldV2(v2.SelectProps{
					Label:         "Tipo de Dato",
					Name:          "tipo_dato",
					Options:       optsTipo,
					SelectedValue: p.TipoDato,
					Required:      true,
					Errors:        errors,
				})
				@v2.SelectFieldV2(v2.SelectProps{
					Label:         "Estatus",
					Name:          "activo",
					Options:       convertidores.OptionFromEstatusGenerico(),
					SelectedValue: convertidores.Traducir(p.IsActive),
					Required:      true,
					Errors:        errors,
				})
				<div class="md:col-span-2">
					@v2.TextAreaFieldV2(v2.TextAreaPropsV2{
						Label:  "Descripción",
						Name:   "descripcion",
						Value:  p.Descripcion,
						Errors: errors,
					})
				</div>
				<div class="md:col-span-2">
					@v2.InputFieldV2(v2.InputPropsV2{
						Label:       "Motivo de Modificación",
						Name:        "razon_m",
						Placeholder: "Ej. Ajuste de timeout",
						Value:       p.RazonM,
						Required:    true,
						Errors:      errors,
					})
				</div>
			</div>
			@v2.ModalFooterV2("Guardar Cambios")
		</form>
	}
}
