package layouts

import (
	"PlantillaInstitucional/shared/pagina"
	"PlantillaInstitucional/shared/utils"
	"PlantillaInstitucional/shared/views/components"
	"PlantillaInstitucional/shared/views/components/v2"
)

templ Base(titulo string) {
	<!DOCTYPE html>
	<html class="h-full bg-[var(--surface-arena-20)]" lang="es-MX">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Plantilla ISSEMYM - UI v2"/>
			<meta name="theme-color" content="#9F2241"/>
			<meta name="csrf-token" content={ utils.GetCSRFToken(ctx) }/>
			<title>{ titulo }</title>
			<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<style type="text/tailwindcss">
				@font-face {
					font-family: 'Gotham';
					src: url('/static/public/font/Gotham/Gotham-Book.otf') format('opentype');
					font-weight: 400;
					font-style: normal;
				}
				@font-face {
					font-family: 'Gotham';
					src: url('/static/public/font/Gotham/Gotham-Medium.otf') format('opentype');
					font-weight: 500;
					font-style: normal;
				}
				@font-face {
					font-family: 'Gotham';
					src: url('/static/public/font/Gotham/Gotham-Bold.otf') format('opentype');
					font-weight: 700;
					font-style: normal;
				}
				@font-face {
					font-family: 'Gotham';
					src: url('/static/public/font/Gotham/Gotham-Black.otf') format('opentype');
					font-weight: 900;
					font-style: normal;
				}

				@theme {
					--color-guinda: #9F2241;
					--color-naranja: #FF6600;
					--color-arena: #D6D1CA;
					--color-negro: #000000;
					--color-blanco: #FFFFFF;

					--surface-arena-20: color-mix(in srgb, var(--color-arena), white 80%);
					--surface-arena-30: color-mix(in srgb, var(--color-arena), white 70%);
					--surface-arena-40: color-mix(in srgb, var(--color-arena), white 60%);
					--surface-arena-60: color-mix(in srgb, var(--color-arena), white 40%);

					--font-sans: 'Gotham', 'Montserrat', system-ui, sans-serif;
					
					--breakpoint-xs: 480px;
				}

				@layer base {
					html {
						font-family: var(--font-sans);
					}
				}
			</style>
			<script defer src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js"></script>
			<script>
				const sharedChartRenders = new Map();
				const maxChartLibraryLoadAttempts = 50;
				window.showSharedChartUnavailable = function(container) {
					container.innerHTML = '<div class="flex items-center justify-center h-full text-gray-500"><p>No se pudo cargar el motor de gráficas. Recargue la página e intente de nuevo.</p></div>';
				};
				window.registerSharedChart = function(id, render) {
					sharedChartRenders.set(id, render);
					render();
				};
				window.renderSharedChart = function(id, rawData, buildOption, loadAttempts = 0) {
					const container = document.getElementById(id);
					if (!container) return;
					if (!window.echarts) {
						if (loadAttempts >= maxChartLibraryLoadAttempts) {
							window.showSharedChartUnavailable(container);
							return;
						}
						setTimeout(() => {
							if (container.isConnected && document.getElementById(id) === container) window.renderSharedChart(id, rawData, buildOption, loadAttempts + 1);
						}, 100);
						return;
					}
					const previous = echarts.getInstanceByDom(container);
					if (previous) previous.dispose();
					try {
						const data = typeof rawData === 'string' ? JSON.parse(rawData) : rawData;
						if (!data || (Array.isArray(data) ? !data.length : !data.labels?.length)) {
							container.innerHTML = '<div class="flex items-center justify-center h-full text-gray-400 font-bold text-xs uppercase tracking-widest"><p>No hay datos para mostrar</p></div>';
							return;
						}
						container.replaceChildren();
						const text = '#1F2937';
						const grid = '#E5E7EB';
						const chart = echarts.init(container);
						chart.setOption({
							backgroundColor: '#FFFFFF',
							textStyle: { color: text },
							tooltip: { backgroundColor: '#FFFFFF', borderColor: grid, textStyle: { color: text } },
							toolbox: { feature: { saveAsImage: { title: 'Exportar como imagen', type: 'png' } } },
							...buildOption(data, { text, grid })
						});
					} catch (error) {
						console.error('Error rendering chart:', error);
						const instance = echarts.getInstanceByDom(container);
						if (instance) instance.dispose();
						container.textContent = 'Error al generar la gráfica';
					}
				};
				function resizeSharedCharts() {
					if (!window.echarts) return;
					document.querySelectorAll('[id$="chart-container"]').forEach(el => echarts.getInstanceByDom(el)?.resize());
				}
				window.addEventListener('resize', resizeSharedCharts);
				document.addEventListener('transitionend', event => {
					if (['width', 'margin-left', 'padding-left', 'grid-template-columns', 'transform'].includes(event.propertyName)) resizeSharedCharts();
				});
				document.addEventListener('htmx:beforeCleanupElement', event => {
					if (!window.echarts) return;
					const root = event.detail.elt;
					if (!(root instanceof Element)) return;
					for (const el of [root, ...root.querySelectorAll('[id$="chart-container"]')]) {
						const chart = echarts.getInstanceByDom(el);
						if (chart) chart.dispose();
						if (el.id) sharedChartRenders.delete(el.id);
					}
				});
			</script>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.6/dist/htmx.min.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			<script>
				document.addEventListener('htmx:configRequest', (event) => {
					const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
					if (csrfToken) {
						event.detail.headers['X-CSRF-Token'] = csrfToken;
					}
				});
				document.addEventListener('htmx:beforeOnLoad', (event) => {
					if (event.detail.xhr.status === 422 || event.detail.xhr.status === 400) {
						event.detail.shouldSwap = true;
						event.detail.isError = false;
					}
				});
				document.addEventListener('htmx:responseError', (event) => {
					if (event.detail.xhr.status === 401) {
						window.location.href = '/login';
					}
				});
			</script>
		</head>
		<body class="h-full bg-[var(--surface-arena-20)] text-gray-900">
			<div id="modal" hx-swap-oob="true"></div>
			<div id="toast-container" class="fixed top-4 right-4 z-[9999] space-y-2" hx-swap-oob="true"></div>
			{ children... }
			<script src="/static/public/js/export-actions.js" defer></script>
		</body>
	</html>
}

// BaseConNav es el layout principal v2, para usuarios firmados.
templ BaseConNav(titulo string, pag pagina.Pagina) {
	@Base(titulo) {
		<div id="contenedor-app-v2" class="min-h-screen flex flex-col" x-data="{ navIzqAbierta: window.innerWidth >= 1280 }">
			<!-- Sidebar con comportamiento responsivo -->
			@v2.SidebarV2(pag)
			<!-- Overlay para movil -->
			<div
				x-show="navIzqAbierta && window.innerWidth < 1280"
				@click="navIzqAbierta = false"
				class="fixed inset-0 bg-black/50 backdrop-blur-xs z-30 xl:hidden"
				x-transition:enter="transition-opacity ease-linear duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition-opacity ease-linear duration-300"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
			></div>
			<!-- Contenido Principal -->
			<div class="relative transition-all duration-300 flex flex-col flex-1" :class="{ 'xl:pl-72': navIzqAbierta, 'pl-0': !navIzqAbierta }">
				@v2.TopbarV2()
				<main class="flex-1 pt-48 pb-12 px-4 sm:px-8 lg:px-12">
					{ children... }
					@components.MensajesFlash()
				</main>
				@components.PiePagina()
			</div>
		</div>
	}
}

// BaseSinNav es el layout v2 para páginas públicas.
templ BaseSinNav(titulo string) {
	@Base(titulo) {
		<main class="min-h-screen">
			{ children... }
			@components.MensajesFlash()
		</main>
		@components.PiePagina()
	}
}
