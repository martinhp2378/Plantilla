package layouts

import (
	"PlantillaInstitucional/shared/entorno"
)

templ Pagina404() {
	@BaseSinNav("Página no encontrada") {
		<div class="min-h-screen flex items-center justify-center p-6 sm:p-12 bg-[var(--surface-arena-20)] relative overflow-hidden">
			<!-- Fondo Decorativo -->
			<div class="absolute top-0 right-0 w-96 h-96 bg-[var(--color-naranja)] opacity-5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
			<div class="absolute bottom-0 left-0 w-64 h-64 bg-[var(--color-guinda)] opacity-5 rounded-full translate-y-1/2 -translate-x-1/2"></div>

			<div class="max-w-2xl w-full text-center space-y-12 relative z-10">
				<!-- Código de Error -->
				<div class="relative inline-block">
					<h2 class="text-[12rem] sm:text-[16rem] font-black text-white leading-none tracking-tighter drop-shadow-2xl">404</h2>
					<div class="absolute inset-0 flex items-center justify-center">
						<span class="text-4xl sm:text-6xl font-black text-[var(--color-guinda)] uppercase tracking-widest">Perdido</span>
					</div>
				</div>

				<div class="space-y-6">
					<h1 class="text-3xl sm:text-4xl font-black text-gray-800 uppercase tracking-tighter">
						Página <span class="text-[var(--color-naranja)]">no encontrada</span>
					</h1>
					<p class="text-sm sm:text-base font-bold text-gray-400 uppercase tracking-widest leading-relaxed max-w-lg mx-auto">
						Lo sentimos, la ruta solicitada no existe o ha sido movida permanentemente.
					</p>
				</div>

				<div class="pt-8">
					<a 
						href="/dashboard" 
						class="inline-flex items-center gap-4 bg-[var(--color-guinda)] text-white px-10 py-5 rounded-2xl text-xs font-black uppercase tracking-[0.2em] shadow-2xl hover:brightness-110 hover:-translate-y-1 active:scale-95 transition-all"
					>
						<span class="material-icons">dashboard</span>
						Volver al Panel de Control
					</a>
				</div>
			</div>
		</div>
	}
}

templ Pagina500() {
	{{ reqId := entorno.ObtenerRequestId(ctx) }}
	@BaseSinNav("Error del Sistema") {
		<div class="min-h-screen flex items-center justify-center p-6 sm:p-12 bg-[var(--surface-arena-20)] relative overflow-hidden">
			<!-- Fondo Decorativo -->
			<div class="absolute top-0 left-0 w-96 h-96 bg-[var(--color-guinda)] opacity-5 rounded-full -translate-y-1/2 -translate-x-1/2"></div>
			
			<div class="max-w-2xl w-full text-center space-y-12 relative z-10">
				<div class="relative inline-block">
					<h2 class="text-[12rem] sm:text-[16rem] font-black text-white leading-none tracking-tighter drop-shadow-2xl">500</h2>
					<div class="absolute inset-0 flex items-center justify-center">
						<span class="text-4xl sm:text-6xl font-black text-[var(--color-naranja)] uppercase tracking-widest">Oops</span>
					</div>
				</div>

				<div class="space-y-6">
					<h1 class="text-3xl sm:text-4xl font-black text-gray-800 uppercase tracking-tighter">
						Error <span class="text-[var(--color-guinda)]">Interno</span>
					</h1>
					<p class="text-sm sm:text-base font-bold text-gray-400 uppercase tracking-widest leading-relaxed">
						Algo salió mal en nuestros servidores. Por favor, proporcione este ID al equipo de soporte:
					</p>
					<div class="inline-block px-6 py-3 bg-white rounded-xl border-2 border-dashed border-[var(--color-arena)] font-mono text-[var(--color-guinda)] font-black">
						{ reqId }
					</div>
				</div>

				<div class="pt-8">
					<a 
						href="/dashboard" 
						class="inline-flex items-center gap-4 bg-[var(--color-guinda)] text-white px-10 py-5 rounded-2xl text-xs font-black uppercase tracking-[0.2em] shadow-2xl hover:brightness-110 transition-all"
					>
						<span class="material-icons">refresh</span>
						Reintentar Acceso
					</a>
				</div>
			</div>
		</div>
	}
}
