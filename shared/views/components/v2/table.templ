package v2

import (
	"fmt"
	"strconv"
)

type TableHeader struct {
	Label     string
	Key       string
	Sortable  bool
	SortURL   string
	SortIcon  string
	FilterVal string
	Align     string // "left", "center", "right"
}

type DataTableV2Props struct {
	Title       string
	Subtitle    string
	Headers     []TableHeader
	CreateURL   string
	SearchURL   string // URL para filtros/búsqueda
	Target      string // ID del contenedor para swaps
	ModalTarget string // ID del modal
	OOB         bool   // Si es verdadero, añade hx-swap-oob="true"

	// Estado de paginacion/orden
	SortedBy  string
	Direction string
	Page      int
	Size      int
	Total     int

	// URLs de exportacion y carga masiva
	PDFExportURL   string
	ExcelExportURL string
	ToastURL       string
	UploadURL      string
}

templ DataTableV2(props DataTableV2Props) {
	<div
		id={ props.Target[1:] }
		if props.OOB {
			hx-swap-oob="true"
		}
		class="space-y-8 fade-in"
	>
		<!-- Titulo Seccion -->
		<h1 class="text-3xl font-bold text-gray-800 tracking-tight">{ props.Title }</h1>
		<!-- Barra de Acciones -->
		<div class="flex items-center justify-between px-2">
			<div class="flex items-center gap-3">
				<div class="p-2 bg-[var(--surface-arena-30)] rounded-lg">
					<span class="material-icons text-[var(--color-guinda)]">view_list</span>
				</div>
				<h2 class="text-xl font-bold text-gray-700">{ props.Subtitle }</h2>
			</div>
			<div class="flex items-center gap-3">
				if props.PDFExportURL != "" {
					<button
						type="button"
						class="js-export-action w-10 h-10 flex items-center justify-center bg-[#E74C3C] text-white rounded-lg shadow-md hover:brightness-110 transition-all active:scale-95"
						data-export-url={ props.PDFExportURL }
						data-toast-url={ props.ToastURL }
					>
						<span class="material-icons text-xl">picture_as_pdf</span>
					</button>
				}
				if props.ExcelExportURL != "" {
					<button
						type="button"
						class="js-export-action w-10 h-10 flex items-center justify-center bg-[#2ECC71] text-white rounded-lg shadow-md hover:brightness-110 transition-all active:scale-95"
						data-export-url={ props.ExcelExportURL }
						data-toast-url={ props.ToastURL }
					>
						<span class="material-icons text-xl">grid_on</span>
					</button>
				}
				if props.UploadURL != "" {
					<button
						hx-get={ props.UploadURL }
						hx-target={ props.ModalTarget }
						hx-swap="innerHTML"
						title="Carga Masiva (CSV)"
						class="w-10 h-10 flex items-center justify-center bg-[#2980B9] text-white rounded-lg shadow-md hover:brightness-110 transition-all active:scale-95"
					>
						<span class="material-icons text-xl">upload_file</span>
					</button>
				}
				if props.CreateURL != "" {
					<button
						hx-get={ props.CreateURL }
						hx-target={ props.ModalTarget }
						hx-swap="innerHTML"
						title="Agregar nuevo"
						class="w-10 h-10 flex items-center justify-center bg-[var(--color-guinda)] text-white rounded-lg shadow-md hover:brightness-110 transition-all active:scale-95"
					>
						<span class="material-icons text-xl">add</span>
					</button>
				}
			</div>
		</div>
		<!-- Card de Tabla con Form de Busqueda -->
		<div class="bg-white rounded-2xl border-2 border-[var(--color-naranja)] shadow-sm overflow-hidden">
			<form id="searchForm" onsubmit="return false;" class="overflow-x-auto">
				<!-- Inputs ocultos para mantener estado -->
				<input type="hidden" name="sort" value={ props.SortedBy }/>
				<input type="hidden" name="dir" value={ props.Direction }/>
				<input type="hidden" name="page" value={ strconv.Itoa(props.Page) }/>
				<input type="hidden" name="size" value={ strconv.Itoa(props.Size) }/>
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="bg-white border-b-2 border-[var(--color-naranja)]">
							for _, h := range props.Headers {
								<th
									class={ "px-8 py-6 align-top", 
									templ.KV("text-center", h.Align == "center"),
									templ.KV("text-right", h.Align == "right"),
									templ.KV("text-left", h.Align == "left" || h.Align == "") }
								>
									<div class="flex flex-col gap-3">
										<div
											class={ "flex items-center justify-between",
											templ.KV("justify-center", h.Align == "center"),
											templ.KV("justify-end", h.Align == "right") }
										>
											if h.Sortable {
												<a
													hx-get={ h.SortURL }
													hx-target={ props.Target }
													hx-swap="outerHTML"
													class={ "cursor-pointer flex items-center justify-between w-full hover:text-[var(--color-naranja)] transition-colors group select-none",
														templ.KV("justify-center", h.Align == "center"),
														templ.KV("justify-end", h.Align == "right") }
												>
													<span class="text-xs font-bold text-[var(--color-guinda)] uppercase tracking-wider group-hover:text-[var(--color-naranja)]">{ h.Label }</span>
													<span class="material-icons text-gray-300 text-sm group-hover:text-[var(--color-naranja)]">
														if h.SortIcon != "" {
															{ h.SortIcon }
														} else {
															swap_vert
														}
													</span>
												</a>
											} else {
												<span class="text-xs font-bold text-[var(--color-guinda)] uppercase tracking-wider">{ h.Label }</span>
											}
										</div>
										<input
											type="text"
											name={ h.Key }
											placeholder="Filtrar"
											value={ h.FilterVal }
											hx-get={ props.SearchURL }
											hx-include="closest form"
											hx-vals='{"page": "1"}'
											hx-target={ props.Target }
											hx-swap="outerHTML"
											hx-trigger="keyup changed delay:500ms, search"
											class={ "w-full px-3 py-2 bg-[var(--surface-arena-20)] border border-[var(--color-arena)] rounded-md text-[10px] font-medium placeholder:text-gray-400 focus:ring-1 focus:ring-[var(--color-naranja)] outline-none transition-all",
												templ.KV("text-center", h.Align == "center"),
												templ.KV("text-right", h.Align == "right") }
										/>
									</div>
								</th>
							}
							<th class="px-8 py-6 text-center align-top">
								<span class="text-xs font-bold text-[var(--color-naranja)] uppercase tracking-wider">Acciones</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-[var(--color-naranja)]/30">
						{ children... }
					</tbody>
				</table>
			</form>
			<!-- Footer Paginacion -->
			<div class="px-10 py-8 bg-white flex items-center justify-between border-t-2 border-[var(--color-naranja)]">
				{{
					pageSize := props.Size
					if pageSize <= 0 {
						pageSize = 10
					}
					page := props.Page
					if page <= 0 {
						page = 1
					}

					start := (page-1)*pageSize + 1
					end := page * pageSize
					if end > props.Total {
						end = props.Total
					}
					if props.Total == 0 {
						start = 0
						end = 0
					}

					totalPages := (props.Total + pageSize - 1) / pageSize
					if totalPages <= 0 {
						totalPages = 1
					}
				}}
				<p class="text-sm font-medium text-gray-500 italic uppercase">
					Mostrando { strconv.Itoa(start) } a { strconv.Itoa(end) } de { strconv.Itoa(props.Total) } registros
				</p>
				@PaginationV2(PaginationV2Props{
					Current: page,
					Total:   totalPages,
					Target:  props.Target,
					BaseURL: props.SearchURL,
				})
			</div>
		</div>
	</div>
}

type PaginationV2Props struct {
	Current int
	Total   int
	Target  string
	BaseURL string
}

templ PaginationV2(props PaginationV2Props) {
	<div class="flex items-center gap-4">
		<!-- Left Button -->
		<button
			if props.Current > 1 {
				hx-get={ fmt.Sprintf("%s?page=%d", props.BaseURL, props.Current-1) }
				hx-target={ props.Target }
				hx-include="#searchForm"
				hx-swap="outerHTML"
			}
			disabled?={ props.Current <= 1 }
			class="w-10 h-10 flex items-center justify-center rounded-xl border-2 border-[var(--color-arena)] text-gray-400 enabled:hover:border-[var(--color-naranja)] enabled:hover:text-[var(--color-naranja)] transition-all disabled:opacity-30"
		>
			<span class="material-icons text-lg font-bold">chevron_left</span>
		</button>
		<div class="flex items-center gap-2">
			for i := 1; i <= props.Total; i++ {
				<button
					hx-get={ fmt.Sprintf("%s?page=%d", props.BaseURL, i) }
					hx-target={ props.Target }
					hx-include="#searchForm"
					hx-swap="outerHTML"
					class={ "w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold transition-all shadow-sm",
						templ.KV("bg-[var(--color-naranja)] text-white", i == props.Current),
						templ.KV("bg-white text-gray-400 border-2 border-[var(--color-arena)] hover:border-[var(--color-naranja)]", i != props.Current) }
				>
					{ strconv.Itoa(i) }
				</button>
			}
		</div>
		<!-- Right Button -->
		<button
			if props.Current < props.Total {
				hx-get={ fmt.Sprintf("%s?page=%d", props.BaseURL, props.Current+1) }
				hx-target={ props.Target }
				hx-include="#searchForm"
				hx-swap="outerHTML"
			}
			disabled?={ props.Current >= props.Total }
			class="w-10 h-10 flex items-center justify-center rounded-xl border-2 border-[var(--color-naranja)] text-[var(--color-naranja)] enabled:hover:bg-[var(--color-naranja)] enabled:hover:text-white transition-all shadow-sm disabled:opacity-30"
		>
			<span class="material-icons text-lg font-bold">chevron_right</span>
		</button>
	</div>
}

type DataRowV2Props struct {
	Cells       []string
	EditURL     string
	DeleteURL   string
	Target      string
	ModalTarget string
}

templ DataRowV2(props DataRowV2Props) {
	<tr class="hover:bg-[var(--surface-arena-20)] transition-colors group">
		for _, cell := range props.Cells {
			<td class="px-8 py-5 text-sm text-gray-600 font-medium">{ cell }</td>
		}
		<td class="px-8 py-5 text-center">
			<div class="flex items-center justify-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
				{ children... }
				if props.EditURL != "" {
					<button
						hx-get={ props.EditURL }
						hx-target={ props.ModalTarget }
						hx-swap="innerHTML"
						title="Editar"
						class="text-[var(--color-guinda)] hover:scale-125 transition-transform"
					>
						<span class="material-icons text-xl">edit</span>
					</button>
				}
				if props.DeleteURL != "" {
					<button
						hx-delete={ props.DeleteURL }
						hx-target={ props.Target }
						hx-swap="outerHTML"
						hx-confirm="¿Está seguro de eliminar este registro?"
						title="Eliminar"
						class="text-gray-400 hover:text-red-500 hover:scale-125 transition-transform"
					>
						<span class="material-icons text-xl">delete</span>
					</button>
				}
			</div>
		</td>
	</tr>
}
