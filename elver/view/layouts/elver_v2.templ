package layouts

import (
	"PlantillaInstitucional/elver"
	"PlantillaInstitucional/elver/view/components"
	"PlantillaInstitucional/pagination"
	"PlantillaInstitucional/shared/pagina"
	"PlantillaInstitucional/shared/views/layouts"
)

templ ViewElverV2(titulo string, data pagination.CriteriosPagina[elver.Elver], baseURL string) {
	@layouts.BaseConNav(titulo, pagina.Pagina("elver")) {
		@components.TableV2(data, baseURL, false)
		<div id="modal"></div>
	}
}
