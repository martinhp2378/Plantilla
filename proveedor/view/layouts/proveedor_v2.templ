package layouts

import (
	"PlantillaInstitucional/pagination"
	"PlantillaInstitucional/proveedor"
	"PlantillaInstitucional/proveedor/view/components"
	"PlantillaInstitucional/shared/pagina"
	"PlantillaInstitucional/shared/views/layouts"
)

templ ViewProveedorV2(titulo string, data pagination.CriteriosPagina[proveedor.Proveedor], baseURL string) {
	@layouts.BaseConNav(titulo, pagina.Pagina("proveedor")) {
		@components.TableV2(data, baseURL, false)
		<div id="modal"></div>
	}
}
