AMBIENTE=LOCAL
SERVICIO=plantilla
ID_PROYECTO=aplicativos-issemym-dev
VERSION=v0.1.0
RELEASE=release solo aplica para GCP
# Timeout para que termine un handler de ejecutarse
# Debería ser menor que el WriteTimeout (del ServerListen)
TIMEOUT=25s
LISTEN_ADDR=:8080
# Database
PQ_WRITE_DB=plantilla
PQ_WRITE_USER=usuplantilla
PQ_WRITE_PASSWORD=
PQ_WRITE_HOST=localhost
PQ_WRITE_PORT=5432
PQ_WRITE_SSL_MODE=disable
PQ_WRITE_MAX_CONNS=8
PQ_WRITE_MIN_CONNS=1
PQ_WRITE_MAX_CONN_IDLE=5
PQ_WRITE_MAX_CONN_LIFE=20
PQ_WRITE_QUERY_TIMEOUT=5
PQ_READ_DB=plantilla
PQ_READ_USER=usuplantilla
PQ_READ_PASSWORD=
PQ_READ_HOST=localhost
PQ_READ_PORT=5432
PQ_READ_SSL_MODE=disable
PQ_READ_MAX_CONNS=10
PQ_READ_MIN_CONNS=1
PQ_READ_MAX_CONN_IDLE=5
PQ_READ_MAX_CONN_LIFE=20
PQ_READ_QUERY_TIMEOUT=5
# Multi-tenant
HABILITAR_MULTI_TENANT=false
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Observability
LOGS_CON_COLORES=true
AGREGAR_SOURCE=true
NOMBRE_SPAN_CORTO=true
QUITAR_ARGS_QUERY=false
QUITAR_PREFIJO_QUERY=false
QUITAR_STATEMENT=false
HABILITAR_METRICAS_AUTOMATICAS=true
DESHABILITAR_TRACING=false
DESHABILITAR_METRICAS=false
USAR_EXPORTADOR_CONSOLA=false
NIVEL=DEBUG
TASA_SAMPLING=1
INTERVALO_METRICAS=60s
# Archivos
ARCHIVOS_DIR_LOCAL=./static
ARCHIVOS_RUTA_PUB_LOCAL=/static/public
ARCHIVOS_RUTA_PRIV_LOCAL=/static/private
ARCHIVOS_CUBETA_PUBLICA=aplicativos-issemym-cdn-static
ARCHIVOS_CUBETA_PRIVADA=aplicativos-issemym-private
ARCHIVOS_URL_CDN=https://34.117.18.30/
ARCHIVOS_EXPIRACION_URLs=15m
ARCHIVOS_CACHE_CONTROL=public, max-age=3600
# Sesiones
COOKIE_NOMBRE=plantilla
COOKIE_PATH=/
COOKIE_DOMINIO=
COOKIE_ES_SECURE=false
DURACION_INACTIVA=2h
DURACION_MAXIMA=12h
FLASH_TTL=5m
MAXIMOS_MENSAJES_FLASH=10
HABILITAR_FINGERPRINTING=true
SESION_DURA_MAS_DE_UN_DIA=false
HABILITAR_REDIS=false
JWT_SECRET_KEY=ESTA_LLAVE_SE_CAMBIA_EN_PRODUCCION_MIN_32
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ENABLE_REFRESH_TOKENS=true
JWT_AUDIENCE=plantilla-mobile
JWT_ALLOWED_CLOCK_SKEW=30s

# Cloud Run / Production configurations
# Puerto de escucha dinámico provisto por el runtime de Cloud Run (se inyecta dinámicamente)
# PORT="8080"
# Bandera booleana para saltear la ejecución automática de migraciones de BD al arrancar la app.
# Útil en Cloud Run con escalado horizontal concurrente para evitar race conditions.
# Las migraciones deben correrse de forma externa (ej: Cloud Run Jobs o Cloud Build).
SKIP_MIGRATIONS=false

