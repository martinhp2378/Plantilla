package compartidos

templ Mensaje(variante, descripcion string) {
	<div hx-swap-oob="beforeend:#toast-container">
		<div
			x-data="{ show: true }"
			x-show="show"
			x-init="setTimeout(() => show = false, 4000); setTimeout(() => $el.remove(), 4500)"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 transform -translate-y-4"
			x-transition:enter-end="opacity-100 transform translate-y-0"
			x-transition:leave="transition ease-in duration-300"
			x-transition:leave-start="opacity-100 transform translate-y-0"
			x-transition:leave-end="opacity-0 transform -translate-y-4"
			class="flex items-center w-full max-w-xs p-4 text-gray-500 bg-white rounded-xl shadow-sm dark:text-slate-400 dark:bg-slate-800"
			role="alert"
		>
			<div class={ "inline-flex items-center justify-center shrink-0 w-8 h-8 rounded-xl " + convertirVariante(variante) }>
				<span class="material-icons text-lg">{ convertirIcono(variante) }</span>
			</div>
			<div class="ml-3 text-sm font-normal">{ descripcion }</div>
			<button
				type="button"
				@click="show = false; setTimeout(() => $el.closest('[role=alert]').remove(), 350)"
				class="ml-auto -mx-1.5 -my-1.5 bg-white text-gray-400 hover:text-gray-900 rounded-xl focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8 dark:text-slate-1000 dark:hover:text-white dark:bg-slate-800 dark:hover:bg-gray-700"
				aria-label="Cerrar"
			>
				<span class="material-icons text-sm">close</span>
			</button>
		</div>
	</div>
}

func convertirVariante(variante string) string {
	variantes := map[string]string{
		"success": "text-green-500 bg-green-100 dark:bg-green-800 dark:text-green-200",
		"error":   "text-red-500 bg-red-100 dark:bg-red-800 dark:text-red-200",
		"info":    "text-blue-500 bg-blue-100 dark:bg-blue-800 dark:text-blue-200",
		"warning": "text-yellow-500 bg-yellow-100 dark:bg-yellow-800 dark:text-yellow-200",
	}

	if clase, ok := variantes[variante]; ok {
		return clase
	}
	// Fallback por si se pasa una variante desconocida
	return "text-gray-500 bg-gray-100 dark:bg-slate-800 dark:text-slate-200"
}

func convertirIcono(variante string) string {
	iconos := map[string]string{
		"success": "check_circle",
		"error":   "highlight_off",
		"info":    "info",
		"warning": "warning",
	}

	if clase, ok := iconos[variante]; ok {
		return clase
	}
	// Fallback por si se pasa una variante desconocida
	return "notifications"
}
