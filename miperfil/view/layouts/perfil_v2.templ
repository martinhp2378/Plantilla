package layouts

import (
	"PlantillaInstitucional/miperfil"
	"PlantillaInstitucional/miperfil/view/components"
	"PlantillaInstitucional/shared/pagina"
	"PlantillaInstitucional/shared/views/layouts"
)

templ ViewMiPerfil(p miperfil.PerfilUsuario, imagenURL string, pag pagina.Pagina) {
	@layouts.BaseConNav("Mi Perfil", pag) {
		@MiPerfilContent(p, imagenURL)
	}
}

templ MiPerfilContent(p miperfil.PerfilUsuario, imagenURL string) {
	<div id="mi-perfil-content" class="space-y-8 animate-fade-in">
		<!-- Encabezado de Sección -->
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-[var(--color-arena)]">
			<div>
				<h1 class="text-2xl sm:text-3xl font-black text-gray-900 uppercase tracking-tight">
					Mi <span class="text-[var(--color-guinda)]">Perfil</span>
				</h1>
				<p class="text-xs sm:text-sm font-bold text-gray-400 uppercase tracking-widest mt-1">
					Consulta tus datos personales, cambia tu contraseña y personaliza tu avatar
				</p>
			</div>
		</div>
		<!-- Grid Principal -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
			<!-- Columna Izquierda: Avatar y Resumen -->
			<div class="space-y-6">
				@components.AvatarContainer(imagenURL, miperfil.MensajeFeedback{})
				<!-- Tarjeta de Cuenta -->
				<div class="bg-white rounded-2xl border-2 border-[var(--color-arena)] p-6 shadow-sm space-y-4">
					<div class="flex items-center gap-3 pb-3 border-b border-[var(--color-arena)]">
						<div class="w-10 h-10 rounded-xl bg-[var(--surface-arena-20)] text-[var(--color-guinda)] flex items-center justify-center">
							<span class="material-icons text-xl">verified_user</span>
						</div>
						<div>
							<p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Rol en Sistema</p>
							<p class="text-sm font-black text-gray-900 uppercase">{ p.Perfil }</p>
						</div>
					</div>
					<div class="flex items-center justify-between text-xs">
						<span class="font-bold text-gray-400 uppercase tracking-wider">Estado:</span>
						<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800">
							<span class="w-2 h-2 rounded-full bg-emerald-500"></span> Activo
						</span>
					</div>
				</div>
			</div>
			<!-- Columna Derecha: Información y Cambio de Contraseña -->
			<div class="lg:col-span-2 space-y-8">
				<!-- Tarjeta de Datos Personales -->
				<div class="bg-white rounded-2xl border-2 border-[var(--color-arena)] p-6 sm:p-8 shadow-sm space-y-6">
					<div class="flex items-center gap-3 pb-4 border-b border-[var(--color-arena)]">
						<div class="w-10 h-10 rounded-xl bg-[var(--surface-arena-20)] text-[var(--color-guinda)] flex items-center justify-center">
							<span class="material-icons text-xl">badge</span>
						</div>
						<div>
							<h2 class="text-base font-black text-gray-900 uppercase tracking-wide">Información Personal</h2>
							<p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Datos institucionales registrados</p>
						</div>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
						<div class="space-y-1">
							<label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Nombre Completo</label>
							<p class="text-sm font-bold text-gray-900 p-3 rounded-xl bg-[var(--surface-arena-20)] border border-[var(--color-arena)]">
								{ p.NombreCompleto() }
							</p>
						</div>
						<div class="space-y-1">
							<label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Correo Electrónico</label>
							<p class="text-sm font-bold text-gray-900 p-3 rounded-xl bg-[var(--surface-arena-20)] border border-[var(--color-arena)] truncate">
								{ p.Email }
							</p>
						</div>
						<div class="space-y-1">
							<label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Clave ISSEMYM</label>
							<p class="text-sm font-bold text-gray-900 p-3 rounded-xl bg-[var(--surface-arena-20)] border border-[var(--color-arena)]">
								{ p.ClaveIssemym }
							</p>
						</div>
						<div class="space-y-1">
							<label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">CURP</label>
							<p class="text-sm font-bold text-gray-900 p-3 rounded-xl bg-[var(--surface-arena-20)] border border-[var(--color-arena)]">
								{ p.Curp }
							</p>
						</div>
						<div class="space-y-1">
							<label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">RFC</label>
							<p class="text-sm font-bold text-gray-900 p-3 rounded-xl bg-[var(--surface-arena-20)] border border-[var(--color-arena)]">
								{ p.Rfc }
							</p>
						</div>
						<div class="space-y-1">
							<label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Perfil de Acceso</label>
							<p class="text-sm font-bold text-gray-900 p-3 rounded-xl bg-[var(--surface-arena-20)] border border-[var(--color-arena)] uppercase">
								{ p.Perfil }
							</p>
						</div>
					</div>
					<p class="text-[10px] font-bold text-gray-400 italic">
						* La modificación de datos de filiación institucional debe solicitarse al área de Recursos Humanos.
					</p>
				</div>
				<!-- Tarjeta de Cambio de Contraseña -->
				<div class="bg-white rounded-2xl border-2 border-[var(--color-arena)] p-6 sm:p-8 shadow-sm space-y-6">
					<div class="flex items-center gap-3 pb-4 border-b border-[var(--color-arena)]">
						<div class="w-10 h-10 rounded-xl bg-[var(--surface-arena-20)] text-[var(--color-guinda)] flex items-center justify-center">
							<span class="material-icons text-xl">lock_reset</span>
						</div>
						<div>
							<h2 class="text-base font-black text-gray-900 uppercase tracking-wide">Cambiar Contraseña</h2>
							<p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Actualiza tus credenciales de acceso</p>
						</div>
					</div>
					<div id="feedback-password"></div>
					<form
						hx-post="/perfil/password"
						hx-target="#feedback-password"
						hx-swap="innerHTML"
						hx-indicator="#password-loading"
						class="space-y-5"
					>
						<div class="space-y-2">
							<label for="password_actual" class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">
								Contraseña Actual <span class="text-[var(--color-naranja)]">*</span>
							</label>
							<input
								type="password"
								id="password_actual"
								name="password_actual"
								required
								autocomplete="current-password"
								placeholder="Ingresa tu contraseña actual"
								class="w-full px-4 py-3 text-sm font-medium rounded-xl border border-[var(--color-arena)] bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-guinda)] focus:border-transparent transition-all"
							/>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-2">
								<label for="password_nueva" class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">
									Nueva Contraseña <span class="text-[var(--color-naranja)]">*</span>
								</label>
								<input
									type="password"
									id="password_nueva"
									name="password_nueva"
									required
									minlength="8"
									autocomplete="new-password"
									placeholder="Mínimo 8 caracteres"
									class="w-full px-4 py-3 text-sm font-medium rounded-xl border border-[var(--color-arena)] bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-guinda)] focus:border-transparent transition-all"
								/>
							</div>
							<div class="space-y-2">
								<label for="password_confirmacion" class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">
									Confirmar Nueva Contraseña <span class="text-[var(--color-naranja)]">*</span>
								</label>
								<input
									type="password"
									id="password_confirmacion"
									name="password_confirmacion"
									required
									minlength="8"
									autocomplete="new-password"
									placeholder="Repite la nueva contraseña"
									class="w-full px-4 py-3 text-sm font-medium rounded-xl border border-[var(--color-arena)] bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-guinda)] focus:border-transparent transition-all"
								/>
							</div>
						</div>
						<div class="pt-2 flex items-center justify-between">
							<button
								type="submit"
								class="px-8 py-3 rounded-xl bg-[var(--color-guinda)] hover:brightness-110 active:scale-95 text-white text-xs font-black uppercase tracking-widest shadow-md transition-all flex items-center gap-2 cursor-pointer"
							>
								<span class="material-icons text-base">save</span>
								Guardar Nueva Contraseña
							</button>
							<span id="password-loading" class="htmx-indicator text-xs font-bold text-[var(--color-guinda)] flex items-center gap-2">
								<span class="material-icons animate-spin text-base">refresh</span>
								Actualizando...
							</span>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}
